# Project: Travelling Salesman Problem Solver
# Allegro 5 - Windows / MinGW
# Requires pkg-config and Allegro 5 installed (e.g. via vcpkg or msys2)

CXX     = g++
BIN     = tsp-solver.exe
SRC     = "Travelling Salesman Problem Solver.cpp"

CXXFLAGS = $(shell pkg-config allegro-5 allegro_main-5 allegro_font-5 allegro_ttf-5 allegro_primitives-5 --cflags)
LIBS     = $(shell pkg-config allegro-5 allegro_main-5 allegro_font-5 allegro_ttf-5 allegro_primitives-5 --libs)

.PHONY: all clean

all: $(BIN)

$(BIN): $(SRC)
	$(CXX) $(SRC) -o $(BIN) $(CXXFLAGS) $(LIBS)

clean:
	del /Q $(BIN) 2>nul || rm -f $(BIN)
